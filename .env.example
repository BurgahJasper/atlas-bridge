# ── Atlas Bridge environment ────────────────────────────────────────────────
# Copy to .env (apps/web) / .env (apps/worker) and fill in as needed.
# The demo path works with NO keys at all: a curated fixture repo + the
# clearly-labeled offline mock provider are used as fallbacks.

# ── AI (TRD §5): Gemma 4 via Gemini API ─────────────────────────────────────
# https://ai.google.dev/gemma/docs/core/gemma_on_gemini_api
GEMINI_API_KEY=
# Hosted Gemma ids: gemma-4-26b-a4b-it | gemma-4-31b-it (verify availability at deploy)
GEMMA_MODEL_ID=gemma-4-26b-a4b-it
# When true, allow the local/self-hosted adapter instead of the hosted API
GEMMA_LOCAL_ADAPTER_URL=

# ── GitHub ingestion (TRD §7) ───────────────────────────────────────────────
# Optional token; public repos work unauthenticated (subject to rate limits)
GITHUB_TOKEN=

# ── Persistence / infra ─────────────────────────────────────────────────────
# Durable file log location when DATABASE_URL is empty (default: .atlas-data/)
ATLAS_DATA_DIR=
# Postgres (TRD §6); leave empty to use the in-memory store (demo/local mode)
DATABASE_URL=
# Redis queue; leave empty to use the embedded in-process queue
REDIS_URL=

# ── Analysis mode ───────────────────────────────────────────────────────────
# embedded = web app runs analysis in-process (demo default, zero infra)
# worker   = web app delegates long jobs to apps/worker over HTTP
ANALYSIS_MODE=embedded
WORKER_URL=http://localhost:4600

# ── Web app ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
